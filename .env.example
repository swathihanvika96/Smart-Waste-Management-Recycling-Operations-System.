APP_NAME="Smart Waste Management & Recycling Operations System"
# development | test | production
ENVIRONMENT=development
DEBUG=false

# Database - SQLite works with no extra install. For PostgreSQL / MySQL install
# requirements-postgres.txt or requirements-mysql.txt and use one of the other URLs.
DATABASE_URL=mysql+pymysql://root:Hanvika%40061120@localhost/waste_db
# DATABASE_URL=postgresql+psycopg2://waste:waste@localhost:5432/waste
# DATABASE_URL=mysql+pymysql://waste:waste@localhost:3306/waste

# JWT (generate a key with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Signs the short-lived cookie used during the Google OAuth2 redirect
SESSION_SECRET=change-me-session-secret

# Google OAuth2 (optional) - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# First super admin created by `python -m app.seed`
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_NAME=Super Admin

# Optional
REDIS_URL=
# comma-separated list
CORS_ORIGINS=http://localhost:3000
